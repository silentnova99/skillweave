# ---------------------------------------------------------------------------
# SkillWeave environment variables
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Supabase: prefer the IPv4 session pooler (port 5432) when the direct host is
# IPv6-only. Keep `?sslmode=require`.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase project keys (optional; the app itself only needs DATABASE_URL).
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_SECRET_KEY=""

# Secret used to sign sessions. Required in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-me"

# Set to true when running behind a proxy / non-Vercel host in development.
AUTH_TRUST_HOST="true"

# Comma separated list of emails automatically granted the ADMIN role.
ADMIN_EMAILS="admin@skillweave.local"

# Optional isolated code judge (e.g. Judge0). Leave blank to use the
# non-execution fallback which returns "not_run" instead of faking results.
CODE_JUDGE_URL=""
CODE_JUDGE_TOKEN=""

# Submission storage. Uploaded files are written here and never executed.
# Defaults to a `.uploads` directory inside the project root.
UPLOAD_DIR=""

# Optional isolated runner used for compilation / test-execution checks on
# project submissions. Without it those checks report SKIPPED rather than
# pretending to have run. The runner receives a JSON body:
#   { action: "compile" | "test", language, files: [{ path, content }] }
# and should reply { status: "PASS" | "FAIL" | "ERROR", detail?, stdout?, stderr? }.
SANDBOX_RUNNER_URL=""
SANDBOX_RUNNER_TOKEN=""
SANDBOX_MODE=""

# Optional overrides for the seeded accounts (otherwise defaults are used).
SEED_ADMIN_EMAIL="admin@skillweave.local"
SEED_ADMIN_PASSWORD="skillweave-admin"
SEED_DEMO_EMAIL="learner@skillweave.local"
SEED_DEMO_PASSWORD="skillweave-learner"
